---
import { steps } from '../config/site';
---

<section id="kak" class="page scroll-mt-20" data-tone="deep" data-fx="split" data-reveal aria-labelledby="kak-title">
  <div class="container-page py-16 lg:py-24">
    <h2 id="kak-title" class="h-section" data-rise>Как проходит заказ</h2>
    <p class="lead mt-3" data-rise>От заявки до готового потолка — пять шагов. Первые два ни к чему не обязывают.</p>

    <ol class="relative mt-10 grid gap-8 lg:grid-cols-5 lg:gap-6">
      {
        steps.map((step, i) => (
          <li class="relative grid grid-cols-[2.75rem_1fr] content-start gap-4 lg:grid-cols-1 lg:gap-5" data-rise>
            <div class="relative flex flex-col items-center lg:flex-row">
              <span class="relative z-10 grid size-11 shrink-0 place-items-center rounded-full bg-plane font-display text-[0.9375rem] font-semibold text-brand-deep ring-1 ring-mist">
                {i + 1}
              </span>
              {i < steps.length - 1 && (
                <span
                  class="absolute top-11 bottom-[-2rem] left-1/2 w-px -translate-x-1/2 bg-mist lg:top-1/2 lg:right-[-1.5rem] lg:bottom-auto lg:left-11 lg:h-px lg:w-auto lg:translate-x-0"
                  aria-hidden="true"
                  data-rise="line"
                  style={`--i:${i}`}
                />
              )}
            </div>
            <div>
              <h3 class="text-[1.0625rem] font-semibold">{step.title}</h3>
              <p class="mt-1.5 text-[0.9375rem] leading-relaxed text-ink-soft">{step.text}</p>
            </div>
          </li>
        ))
      }
    </ol>
  </div>
</section>
