---
import Logo from './Logo.astro';
import { IconPhone, IconTelegram, IconWhatsApp } from './icons';
import { site } from '../config/site';
import { waLink } from '../lib/whatsapp';

const year = new Date().getFullYear();
---

<footer class="border-t border-line bg-plane">
  <div class="container-page grid gap-10 py-12 md:grid-cols-[1.4fr_1fr_1fr]">
    <div>
      <Logo />
      <p class="mt-4 max-w-sm text-[0.9375rem] text-ink-soft">
        {site.master}, натяжные потолки {site.baseCityIn} и по всему Дагестану. Замер бесплатный.
      </p>
    </div>

    <div>
      <h2 class="font-semibold">Связаться</h2>
      <ul class="mt-3 grid gap-2 text-[0.9375rem]">
        <li>
          <a href={`tel:+${site.phoneDigits}`} class="inline-flex items-center gap-2 hover:text-brand-deep">
            <IconPhone size={18} />
            {site.phone}
          </a>
        </li>
        <li>
          <a href={waLink()} target="_blank" rel="noopener" class="inline-flex items-center gap-2 hover:text-brand-deep">
            <IconWhatsApp size={18} />
            WhatsApp
          </a>
        </li>
        <li>
          <a href={site.telegram} target="_blank" rel="noopener" class="inline-flex items-center gap-2 hover:text-brand-deep">
            <IconTelegram size={18} />
            Telegram-канал с работами
          </a>
        </li>
        {
          site.instagram && (
            <li>
              <a href={site.instagram} target="_blank" rel="noopener" class="hover:text-brand-deep">
                Instagram
              </a>
            </li>
          )
        }
      </ul>
    </div>

    <div>
      <h2 class="font-semibold">На сайте</h2>
      <ul class="mt-3 grid gap-2 text-[0.9375rem] text-ink-soft">
        <li><a href="/#vidy" class="hover:text-ink">Виды потолков</a></li>
        <li><a href="/raboty/" class="hover:text-ink">Примеры потолков</a></li>
        <li><a href="/#calc" class="hover:text-ink">Расчёт стоимости</a></li>
        <li><a href="/#voprosy" class="hover:text-ink">Частые вопросы</a></li>
      </ul>
    </div>
  </div>
  <div class="border-t border-line">
    <div class="container-page flex flex-col gap-2 py-5 text-[0.8125rem] text-ink-soft sm:flex-row sm:justify-between">
      <p>© {year} {site.brand}</p>
      <p>Цены на сайте предварительные и не являются публичной офертой.</p>
    </div>
  </div>
</footer>
