---
import { Image } from 'astro:assets';
import ceiling from '../assets/hero/ceiling.jpg';
import { site } from '../config/site';
import { plural } from '../lib/plural';

// Первый экран: фото потолка с подсветкой и крупный заголовок «Натяжные потолки Сантлада».
// Подмена фото: файл src/assets/hero/ceiling.jpg (потолок в верхней части кадра, от 1600 px по ширине).
const lead = 'Хасавюрт и весь Дагестан. Световые линии, парящие и теневые потолки.';
const facts = [
  `Гарантия ${site.guaranteeYears} ${plural(site.guaranteeYears, ['год', 'года', 'лет'])}`,
  `Опыт ${site.experience}`,
];
---

<section class="hero">
  <Image
    src={ceiling}
    alt=""
    widths={[640, 1024, 1600, 2000]}
    sizes="100vw"
    format="webp"
    quality={82}
    loading="eager"
    fetchpriority="high"
    class="hero-photo"
  />
  <div class="hero-shade" aria-hidden="true"></div>

  <div class="container-page hero-body">
    <h1 class="hero-title">
      <span>Натяжные</span>
      <span>потолки</span>
      <span>{site.brandRu}</span>
    </h1>
    <p class="hero-lead">{lead}</p>
    <ul class="hero-facts">
      {facts.map((f) => <li>{f}</li>)}
    </ul>

    <div class="hero-actions">
      <a href="#raboty" class="btn-primary btn-shine hero-more">Смотреть работы</a>
      <a href="#ceny" data-magnet class="btn-ghost hero-cta">Цены на полотна</a>
    </div>
  </div>
</section>
