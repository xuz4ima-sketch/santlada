---
import { Image } from 'astro:assets';
import ceiling from '../assets/hero/ceiling.jpg';
import { site } from '../config/site';

// Текст собирается из размытия: буквы названия и слова строки выходят по очереди (Blur Text из React Bits).
// Для скринридера — обычная строка, разбитые на части копии скрыты.
const lead = 'Натяжные потолки в Хасавюрте и по всему Дагестану';
const letters = [...site.brand];
const words = lead.split(' ');
---

<section class="hero">
  <Image
    src={ceiling}
    alt=""
    widths={[640, 1024, 1600]}
    sizes="100vw"
    format="webp"
    quality={82}
    loading="eager"
    fetchpriority="high"
    class="hero-photo"
  />

  <div class="container-page hero-body">
    <h1>
      <span class="sr-only">{site.brand} — {lead}</span>
      <span class="hero-brand" aria-hidden="true">
        {letters.map((ch, i) => <span class="hero-char" style={`--i:${i}`}>{ch}</span>)}
      </span>
      <span class="hero-lead" aria-hidden="true">
        {words.map((w, i) => <><span class="hero-word" style={`--i:${i}`}>{w}</span>{' '}</>)}
      </span>
    </h1>
    <div class="hero-actions">
      <a href="#calc" data-calc data-magnet class="btn-primary btn-shine hero-cta">Рассчитать стоимость</a>
      <a href="#raboty" class="btn-ghost hero-more">Смотреть работы</a>
    </div>
  </div>
</section>
